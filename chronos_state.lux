// chronos_state.lux — Live Pythagorean & Metric Chronos Engine

class PlanetInfo {
  init(name, root, archangel, spirit) {
    this.name = name;
    this.root = root;
    this.archangel = archangel;
    this.spirit = spirit;
  }

  label() {
    return this.name + " [" + this.root + "] (" + this.archangel + " / " + this.spirit + ")";
  }
}

class Chronos {
  init(hour, minute, second, unixDays, anchorUnixDays) {
    this.hour = hour;
    this.minute = minute;
    this.second = second;
    this.unixDays = unixDays;
    this.personalDays = unixDays - anchorUnixDays;
  }

  // 1. Metric Time (00.00 to 99.99 LMT)
  centidays() {
    var fraction = (this.second / 86400.0) + (this.minute / 1440.0) + (this.hour / 24.0);
    return fraction * 100.0;
  }

  // 2. Macro Cycles (10-day Dekade, 20-day Sprint, 100-day Arc, 365-day Solar Arc)
  dekadeDay() {
    return (this.personalDays % 10) + 1;
  }

  twentyDaySprint() {
    return (this.personalDays % 20) + 1;
  }

  hundredDayArc() {
    return (this.personalDays % 100) + 1;
  }

  solarYearArc() {
    return (this.personalDays % 365) + 1;
  }

  // 3. Pythagorean Planetary Lookup
  planetDetails(planetName) {
    if (planetName == "Sun")     return PlanetInfo("Sun", 1, "Michael", "Och");
    if (planetName == "Moon")    return PlanetInfo("Moon", 2, "Gabriel", "Phul");
    if (planetName == "Jupiter") return PlanetInfo("Jupiter", 3, "Sachiel", "Bethor");
    if (planetName == "Mercury") return PlanetInfo("Mercury", 5, "Raphael", "Ophiel");
    if (planetName == "Venus")   return PlanetInfo("Venus", 6, "Anael", "Hagith");
    if (planetName == "Saturn")  return PlanetInfo("Saturn", 8, "Cassiel", "Aratron");
    if (planetName == "Mars")    return PlanetInfo("Mars", 9, "Samael", "Phaleg");
    return PlanetInfo("Unknown", 0, "None", "None");
  }

  // Day Planet (locked to Unix Epoch Thursday = 0)
  dayPlanet() {
    var weekOrder = ["Jupiter", "Venus", "Saturn", "Sun", "Moon", "Mars", "Mercury"];
    return this.planetDetails(weekOrder[this.unixDays % 7]);
  }

  // Chaldean Planetary Hour (anchored to 06:00 sunrise; 00:00–05:59 belongs to prior planetary day)
  planetaryHour() {
    var chaldean = ["Saturn", "Jupiter", "Mars", "Sun", "Venus", "Mercury", "Moon"];
    
    var effectiveDays = this.unixDays;
    var hoursSinceSunrise = this.hour - 6;
    if (hoursSinceSunrise < 0) {
      effectiveDays = effectiveDays - 1;
      hoursSinceSunrise = hoursSinceSunrise + 24;
    }

    var dayStartOffset = ((effectiveDays % 7) * 3) + 1;
    var index = (dayStartOffset + hoursSinceSunrise) % 7;
    return this.planetDetails(chaldean[index]);
  }

  // 4. Lightweight Obsidian YAML Frontmatter Stamp
  toObsidianHeader() {
    var dPlanet = this.dayPlanet();
    var hPlanet = this.planetaryHour();
    var out = "---\n";
    out = out + "metric_time: " + this.centidays() + " LMT\n";
    out = out + "dekade_day: " + this.dekadeDay() + "\n";
    out = out + "twenty_sprint: " + this.twentyDaySprint() + "\n";
    out = out + "hundred_arc: " + this.hundredDayArc() + "\n";
    out = out + "solar_arc: " + this.solarYearArc() + "\n";
    out = out + "day_planet: " + dPlanet.name + "\n";
    out = out + "day_root: " + dPlanet.root + "\n";
    out = out + "hour_planet: " + hPlanet.name + "\n";
    out = out + "hour_root: " + hPlanet.root + "\n";
    out = out + "---\n";
    return out;
  }
}

fun nowChronos(anchorUnixDays) {
  var a = args();

  // Plan 9 / 9front mode: run `./8.out chronos_state.lux 9front`
  if (a.length > 0 and a[0] == "9front") {
    // `date -n` prints raw UTC epoch seconds; adjust -21600s (-6h) for CST
   var rawSec = run("date -n");
    var localSec = parseJSON(rawSec) - 21600; // CST (-6h)
    var days = (localSec - (localSec % 86400)) / 86400;
    var rem = localSec - (days * 86400);
    var h = (rem - (rem % 3600)) / 3600;
    var afterH = rem - (h * 3600);
    var m = (afterH - (afterH % 60)) / 60;
    var s = afterH - (m * 60);
    return Chronos(h, m, s, days, anchorUnixDays);
  }

  // POSIX / macOS mode (default)
  var cmd = "sh -c '";
  cmd = cmd + "h=$(date +%-H); m=$(date +%-M); s=$(date +%-S); ";
  cmd = cmd + "off=$(date +%z | awk \"{print substr(\\$0,1,1)(substr(\\$0,2,2)*3600 + substr(\\$0,4,2)*60)}\"); ";
  cmd = cmd + "now_days=$(( ($(date +%s) + off) / 86400 )); ";
  cmd = cmd + "echo \"{\\\"h\\\":$h,\\\"m\\\":$m,\\\"s\\\":$s,\\\"days\\\":$now_days}\"";
  cmd = cmd + "'";

  var d = parseJSON(run(cmd));
  return Chronos(d.h, d.m, d.s, d.days, anchorUnixDays);
}


var chronos = nowChronos(20454);

print "Metric Time:    " + chronos.centidays() + " LMT";
print "Dekade Day:     " + chronos.dekadeDay() + " / 10";
print "20-Day Sprint:  " + chronos.twentyDaySprint() + " / 20";
print "100-Day Arc:    " + chronos.hundredDayArc() + " / 100";
print "Solar Arc:      " + chronos.solarYearArc() + " / 365";
print "Day Ruler:      " + chronos.dayPlanet().label();
print "Hour Ruler:     " + chronos.planetaryHour().label();
print "\n--- Obsidian Frontmatter ---";
print chronos.toObsidianHeader();

